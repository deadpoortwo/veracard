# Local OTP is 111111 only outside production. Never deploy local email mode publicly.
NODE_ENV=development
VITE_DYNAMIC_ENVIRONMENT_ID=
API_PORT=4174
# Optional: set DATABASE_URL (e.g. Neon/Supabase Postgres) for persistent cloud storage.
# When omitted, falls back to local SQLite at DATABASE_PATH.
DATABASE_URL=
DATABASE_PATH=server/data/veracard.sqlite
# Set real RPC endpoints to enable live chain balances. No fake balance fallback.
BSC_RPC_URL=
ETH_RPC_URL=
# Production requires real SMTP and HTTPS termination with /api reverse proxy.
SMTP_URL=
MAIL_FROM=
